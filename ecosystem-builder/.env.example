# Copy this file to `.env` (which is gitignored) and fill in your real key.
#   cp .env.example .env
# NEVER paste your real key into chat or commit it.

# Get one at: https://www.perplexity.ai/settings/api
PERPLEXITY_API_KEY=pplx-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Optional — defaults to "sonar". Use "sonar-pro" for deeper research.
PERPLEXITY_MODEL=sonar

# --- GENERATE step (generate-ecosystem.mjs) ---
# OpenAI-compatible LLM used to design the demo chatbot. Default = xAI Grok.
LLM_API_KEY=xai-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
LLM_BASE_URL=https://api.x.ai/v1
LLM_MODEL=grok-4
# To reuse Perplexity instead: LLM_BASE_URL=https://api.perplexity.ai · LLM_MODEL=sonar · LLM_API_KEY=<pplx key>

# --- PITCH step (send-outreach.mjs) ---
# Resend API key: https://resend.com/api-keys — set up SPF/DKIM/DMARC on the
# sending domain (ganesh.guru) in Resend BEFORE sending anything. Sender domain
# matches the demo-link domain on purpose: better trust + deliverability.
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxx
# Sender identity (CAN-SPAM: must be truthful).
# hello@ganesh.guru = Ecosystem Builder outreach (matches demo domain).
# ai@mangasm.app = Mangasm product mail ONLY — never B2B outreach (brand separation).
FROM_EMAIL=Mangasm Enterprises <hello@ganesh.guru>
# Real postal address (CAN-SPAM requirement; a registered agent/PO box works)
PHYSICAL_ADDRESS=123 Your Real St, City, CA 00000
# Warmup throttle: start at 10/day, raise ~20% per week if deliverability holds
DAILY_SEND_CAP=10
