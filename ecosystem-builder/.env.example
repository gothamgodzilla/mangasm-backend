# Copy this file to `.env` (which is gitignored) and fill in your real key.
#   cp .env.example .env
# NEVER paste your real key into chat or commit it.

# Get one at: https://www.perplexity.ai/settings/api
PERPLEXITY_API_KEY=pplx-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Optional — defaults to "sonar". Use "sonar-pro" for deeper research.
PERPLEXITY_MODEL=sonar
